{
  "name": "buildright-website",
  "version": "1.1.0",
  "description": "BuildRight Solutions website prototype",
  "scripts": {
    "start": "node server.js",
    "serve": "npx http-server -p 8000 -c-1",
    "build": "node scripts/tools/build.js",
    "prebuild": "echo 'Injecting blocks...'",
    "get-aco-data": "cd ../buildright-aco && npm run generate:eds-data",
    "sync:images": "bash scripts/sync-product-images.sh",
    "validate-paths": "node scripts/tools/validate-html-paths.js",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "install:dropins": "node scripts/postinstall.js",
    "test": "npx playwright test",
    "test:vitest": "npx vitest run",
    "test:vitest:watch": "npx vitest",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug"
  },
  "keywords": [
    "buildright",
    "b2b",
    "commerce",
    "eds"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "glob": "^10.4.5"
  },
  "devDependencies": {
    "@demo-inspector/sdk": "github:skukla/demo-inspector-sdk",
    "@dropins/storefront-auth": "^2.1.5",
    "@dropins/storefront-cart": "^1.5.1",
    "@dropins/storefront-checkout": "^2.1.0",
    "@dropins/storefront-order": "^1.4.0",
    "@dropins/storefront-pdp": "^1.3.5",
    "@dropins/storefront-product-discovery": "^2.1.0",
    "@dropins/tools": "^1.5.3",
    "@playwright/test": "^1.57.0",
    "husky": "^9.1.7",
    "vitest": "^4.0.16"
  }
}
